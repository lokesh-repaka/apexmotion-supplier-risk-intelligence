# ==============================================================================
# ApexMotion Supplier Risk Intelligence Platform - Root Terraform Configuration
# Reference: TASKS.md (P16-3), CLAUDE.md Sec 6, and HLD Sec 6 & 7
# ==============================================================================

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "ApexMotion-Supplier-Risk-Intelligence"
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}

data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_caller_identity" "current" {}
