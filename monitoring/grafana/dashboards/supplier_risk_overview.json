  "description": "ApexMotion Supplier Risk Intelligence & Service Level Objective (SLO) Monitoring Dashboard. Covers p95 Investigation Latency (<=90s SLA), Kafka Consumer Lag (Critical >5000), HITL Approval Queue Depths, LLM Cost Governance, and Security Guardrails.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Core Service Level Objectives (SLOs) & Queue Depths",
      "type": "row"
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Measures end-to-end investigation workflow duration against the p95 <= 90s SLA gate (PRD Sec 14, FRD FR-DEC-001).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Duration (Seconds)",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(apexmotion_investigation_duration_seconds_bucket{}[$interval])) by (le))",
          "legendFormat": "p95 Investigation Latency",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(apexmotion_investigation_duration_seconds_bucket{}[$interval])) by (le))",
          "legendFormat": "p50 Investigation Latency",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Investigation Latency SLO (p95 <= 90s)",
      "type": "timeseries"
    },
