# ==============================================================================
# ApexMotion Supplier Risk Intelligence Platform — Environment Configuration
# ==============================================================================
# All parameters are validated at runtime via pydantic-settings in src/core/config.py.
# Copy this file to .env and replace placeholders with environment-specific values.
# NEVER commit .env to version control.

# AWS Infrastructure
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=123456789012

# Aurora PostgreSQL (SQLAlchemy Async Connection String)
DATABASE_URL=postgresql+asyncpg://apexmotion_app:local_dev_password@localhost:5432/apexmotion

# Amazon Neptune (OpenCypher Graph DB)
NEPTUNE_ENDPOINT=localhost
NEPTUNE_PORT=8182

# Amazon OpenSearch (Vector Search)
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_INDEX_CONTRACTS=contracts-v1
OPENSEARCH_INDEX_NEWS=news-v1

# Amazon ElastiCache / Redis
REDIS_URL=redis://localhost:6379/0

# Amazon MSK / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SUPPLIER_EVENTS=supplier-events
KAFKA_TOPIC_RISK_ALERTS=risk-alerts
KAFKA_TOPIC_HITL_REQUIRED=hitl-required
KAFKA_TOPIC_AUDIT_EVENTS=audit-events
KAFKA_CONSUMER_GROUP=apexmotion-risk-engine

# LiteLLM Gateway & AI Models
LITELLM_BASE_URL=http://localhost:4000
BEDROCK_SYNTHESIS_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EXTRACTION_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
VLLM_BASE_URL=http://localhost:8080

# Keycloak Identity & RBAC (OIDC)
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=apexmotion
KEYCLOAK_CLIENT_ID=apexmotion-risk-api
KEYCLOAK_CLIENT_SECRET=local_dev_keycloak_secret

# AWS KMS (ECDSA P-256 Key for HITL Signatures)
KMS_KEY_ARN=arn:aws:kms:eu-central-1:123456789012:key/12345678-1234-1234-1234-123456789012

# Langfuse LLM Observability
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_HOST=http://localhost:3000

# HITL Spend Authority Gates (Thresholds in USD)
HITL_TIER_1_THRESHOLD_USD=25000.00
HITL_TIER_2_THRESHOLD_USD=100000.00

# Local Development & Offline Mock Flags
USE_LOCALSTACK=true
USE_MOCK_LLM=true
USE_LOCAL_KAFKA=true
